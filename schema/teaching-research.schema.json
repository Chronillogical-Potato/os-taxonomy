{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "topicFileSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "recordCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "coverage": {
      "type": "object",
      "properties": {
        "topicCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "withResearch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "withoutResearch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "bySubject": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "topics": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "withResearch": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "withoutResearch": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "topics",
              "withResearch",
              "withoutResearch"
            ],
            "additionalProperties": false
          }
        },
        "missingTopicIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^mt_"
          }
        }
      },
      "required": [
        "topicCount",
        "withResearch",
        "withoutResearch",
        "bySubject",
        "missingTopicIds"
      ],
      "additionalProperties": false
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "topicId": {
            "type": "string",
            "pattern": "^mt_"
          },
          "pedagogy": {
            "type": "object",
            "properties": {
              "summary": {
                "type": "string",
                "description": "1-2 sentences: how this concept is best taught"
              },
              "bestPractices": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Research-backed teaching approaches"
              },
              "keyRepresentations": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Canonical models/manipulatives (number line, area model, ten-frame, …)"
              },
              "commonMisconceptions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "summary",
              "bestPractices",
              "keyRepresentations",
              "commonMisconceptions"
            ],
            "additionalProperties": false
          },
          "learn": {
            "type": "object",
            "properties": {
              "schemaVersion": {
                "type": "number",
                "const": 2
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "activities": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "title": {
                      "type": "string",
                      "minLength": 1
                    },
                    "learnerActions": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "intendedInsight": {
                      "type": "string",
                      "minLength": 1
                    },
                    "feedback": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "rationale": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sourceClaims": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "description": "Exact sources[].claim strings supporting the rationale; [] when none directly supports it. Not evidence that this activity has been tested."
                    }
                  },
                  "required": [
                    "title",
                    "learnerActions",
                    "intendedInsight",
                    "feedback",
                    "rationale",
                    "sourceClaims"
                  ],
                  "additionalProperties": false
                }
              },
              "constraints": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "Educational requirements, unsuitable shortcuts, and limits of scaffolds"
              },
              "reviewNotes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "Uncertainties or issues requiring review; never invent evidence to resolve them"
              }
            },
            "required": [
              "schemaVersion",
              "summary",
              "activities",
              "constraints",
              "reviewNotes"
            ],
            "additionalProperties": false
          },
          "assess": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "method": {
                    "type": "string",
                    "enum": [
                      "two_tier",
                      "performance_task",
                      "interpret_translate",
                      "use_in_context",
                      "open_epistemic_probe"
                    ],
                    "description": "Must match the topic type — see assessMethodForType"
                  },
                  "diagnosticPrompt": {
                    "type": "string",
                    "description": "One discriminating question or task, stated open — no lettered options"
                  },
                  "correctAnswer": {
                    "type": "string",
                    "description": "What a child who holds the idea says. For META, an exemplar strong response, not a key"
                  },
                  "whatMakesItDiscriminate": {
                    "type": "string",
                    "description": "Why correct reasoning cannot land on a wrong answer, and vice versa"
                  },
                  "errorPatterns": {
                    "minItems": 1,
                    "maxItems": 8,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "pattern": {
                          "type": "string",
                          "description": "The wrong idea, in the child's voice — not an abstract label"
                        },
                        "kind": {
                          "type": "string",
                          "enum": [
                            "misconception",
                            "myth",
                            "developmental",
                            "interference",
                            "performance"
                          ],
                          "description": "What sort of error this is; dictates whether to confront it"
                        },
                        "revealedBy": {
                          "type": "string",
                          "description": "The tell — what the child says or does that exposes it"
                        },
                        "nextMove": {
                          "type": "string",
                          "description": "What the teacher does about it. For developmental/performance kinds, say what NOT to do"
                        },
                        "distractor": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "description": "Option text when diagnosticPrompt can elicit this pattern; null when another task surfaces it, or the kind is developmental/performance"
                        },
                        "reteachPrerequisiteId": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "description": "MicroTopic id of a prerequisite to drop back to, or null to reteach in place"
                        }
                      },
                      "required": [
                        "pattern",
                        "kind",
                        "revealedBy",
                        "nextMove",
                        "distractor",
                        "reteachPrerequisiteId"
                      ],
                      "additionalProperties": false
                    },
                    "description": "The wrong ideas to listen for, each bound to its tell and its next move"
                  },
                  "probeDeeper": {
                    "minItems": 2,
                    "maxItems": 4,
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Topic-tuned follow-ups that push an assertion into a causal explanation"
                  },
                  "responseLevels": {
                    "type": "object",
                    "properties": {
                      "gap": {
                        "type": "string",
                        "description": "What a child without the idea says or does"
                      },
                      "partial": {
                        "type": "string",
                        "description": "Names the parts but cannot connect them — the multistructural plateau"
                      },
                      "full": {
                        "type": "string",
                        "description": "Links the parts causally and transfers to a new case"
                      }
                    },
                    "required": [
                      "gap",
                      "partial",
                      "full"
                    ],
                    "additionalProperties": false
                  },
                  "poeTask": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "A predict-observe-explain demonstration, or null when no such phenomenon exists"
                  }
                },
                "required": [
                  "method",
                  "diagnosticPrompt",
                  "correctAnswer",
                  "whatMakesItDiscriminate",
                  "errorPatterns",
                  "probeDeeper",
                  "responseLevels",
                  "poeTask"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "claim": {
                  "type": "string",
                  "description": "The pedagogical claim this source backs"
                },
                "source": {
                  "type": "string",
                  "description": "Named body of work / publication"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "verified": {
                  "type": "boolean",
                  "description": "Whether the agent confirmed the source supports the claim"
                }
              },
              "required": [
                "claim",
                "source",
                "verified"
              ],
              "additionalProperties": false
            }
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "provenance": {
            "type": "object",
            "properties": {
              "originalResearchGeneratedBy": {
                "type": "string",
                "minLength": 1
              },
              "createdAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
              },
              "updatedAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
              }
            },
            "required": [
              "originalResearchGeneratedBy",
              "createdAt",
              "updatedAt"
            ],
            "additionalProperties": false
          },
          "publicationNotes": {
            "type": "object",
            "properties": {
              "omittedCurriculumText": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "codes": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "required": [
                    "path",
                    "codes"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "omittedCurriculumText"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "topicId",
          "pedagogy",
          "learn",
          "assess",
          "sources",
          "confidence",
          "provenance",
          "publicationNotes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "version",
    "exportedAt",
    "topicFileSha256",
    "recordCount",
    "coverage",
    "notes",
    "records"
  ],
  "additionalProperties": false,
  "$id": "https://withmarble.com/taxonomy/schema/teaching-research.schema.json",
  "title": "Marble Skill Taxonomy — teaching research"
}
